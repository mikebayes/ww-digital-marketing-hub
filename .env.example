# Supabase — Client Intakes.
# Copy to .env.local for local development, and set the same three in Vercel.
#
# Project settings → API in the Supabase dashboard.

# Safe to expose to the browser. Subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET. Bypasses Row Level Security entirely.
#
# Used by one thing: the public questionnaire at /intake/<token>, which has no
# signed-in user to run queries as. Never prefix this with NEXT_PUBLIC_, never
# import it into a client component, and never commit a filled-in copy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
