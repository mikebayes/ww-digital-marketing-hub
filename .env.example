# Client Intakes.
# Copy to .env.local for local development, and set the same four in Vercel.
#
# The Supabase values are in Project settings → API in the dashboard.

# Safe to expose to the browser. Subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET. Bypasses Row Level Security entirely.
#
# Used by the public questionnaire at /intake/<token>, which has no signed-in
# user to run queries as, and temporarily by the intake admin for the same
# reason. Never prefix this with NEXT_PUBLIC_, never import it into a client
# component, and never commit a filled-in copy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECRET. TEMPORARY — the shared key holding /intakes while Microsoft sign-in
# is unavailable. See the README and lib/auth/temporary-gate.ts; delete this
# variable when that gate is removed.
#
# Long and random, not memorable — it is one key for the whole team and there
# is no per-account lockout behind it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
INTAKES_ACCESS_KEY=
